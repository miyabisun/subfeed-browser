<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dev.miyabisun.subfeedbrowser.PullLayout
        android:id="@+id/pull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </dev.miyabisun.subfeedbrowser.PullLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/popup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/progress"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/failure"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/failure_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/failure_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/failure_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/failure_hint"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/change_url"
                    style="@style/Button"
                    android:layout_marginEnd="8dp"
                    android:text="@string/change_url" />

                <Button
                    android:id="@+id/retry"
                    style="@style/Button.Primary"
                    android:text="@string/retry" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</merge>
